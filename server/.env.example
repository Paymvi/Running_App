# Copy to server/.env and fill in. Never commit server/.env.
# From https://www.strava.com/settings/api
STRAVA_CLIENT_ID=your-client-id
STRAVA_CLIENT_SECRET=your-client-secret
# Must match the "Authorization Callback Domain" registered with Strava.
STRAVA_REDIRECT_URI=http://localhost:5050/auth/strava/callback
# Where the Velo frontend runs (no trailing slash). Also the only allowed CORS origin.
FRONTEND_URL=http://localhost:5173
PORT=5050
